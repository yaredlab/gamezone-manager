# ============================================================
# GameZone Manager V2 — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# ── PostgreSQL connection ─────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://gamezone_user:your_password_here@localhost:5432/gamezone_v2"

# ── Server ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── JWT Authentication (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=change_this_to_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=8h

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# ── bcrypt ───────────────────────────────────────────────────
BCRYPT_ROUNDS=12
